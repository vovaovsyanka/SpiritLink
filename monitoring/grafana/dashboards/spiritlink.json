          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{env=~\"$env\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
