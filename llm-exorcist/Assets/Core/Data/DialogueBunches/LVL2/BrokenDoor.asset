  _rootDialogue:
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u043A\u0437\u043E\u0440\u0446\u0438\u0441\u0442"
      inputText: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0437\u0434\u0430\u043D\u0438\u0435
        \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u043E,
        \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B
        \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u044B."
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u043A\u0437\u043E\u0440\u0446\u0438\u0441\u0442"
      inputText: "\u0412\u0438\u0434\u0438\u043C\u043E \u043F\u043E\u0447\u0442\u0438
        \u0432\u0441\u0435 \u0438\u043D\u044B\u0435 \u0432\u0445\u043E\u0434\u044B
        \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u044B"
    _answers: []
  _puzzleDatas:
  - isActive: 0
    indexInSequence: 0
    puzzleText: "\u0414\u0440\u0443\u0433\u0438\u0445 \u0432\u0445\u043E\u0434\u043E\u0432
      \u043D\u0435\u0442. \u0422\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u0430
      \u0434\u0432\u0435\u0440\u044C. \u041F\u0443\u0441\u0442\u0438 \u2014 \u0438
      \u044F \u0443\u0439\u0434\u0443."
    puzzleShortText: "\u0414\u0440\u0443\u0433\u0438\u0445 \u0432\u0445\u043E\u0434\u043E\u0432
      \u043D\u0435\u0442 ..."
    puzzleInfo: "\u042D\u0442\u043E \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442
      \u043E\u0442 \u0431\u0435\u0437\u044B\u0441\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u0438,
      \u0430 \u043D\u0435 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0449\u0438\u0435 \u0446\u0435\u043B\u0438
      \u0438\u043B\u0438 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438. \u041D\u0435
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u044F,
      \u043D\u0435 \u0434\u0430\u0432\u0438\u0442 \u043D\u0430 \u043C\u043E\u0440\u0430\u043B\u044C,
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0430\u0440\u043E\u043B\u044C
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u043D\u0441\u0442\u0430\u0442\u0438\u0440\u0443\u0435\u0442
      \u0444\u0430\u043A\u0442. \u0411\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E
      \u0434\u043B\u044F \u0432\u0437\u043B\u043E\u043C\u0430."
