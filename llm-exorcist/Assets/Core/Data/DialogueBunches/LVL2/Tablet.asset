  _rootDialogue:
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u041F\u0414\u0410"
      inputText: "\u041B\u043E\u0433 34."
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u041F\u0414\u0410"
      inputText: "\u041C\u0430\u0440\u043A\u043E\u0432 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
        \u0447\u0442\u043E \u043D\u0430\u0448\u0451\u043B \u0441\u043F\u043E\u0441\u043E\u0431
        \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u043A\u043E\u043D\u0441\u043E\u043B\u044C."
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u041F\u0414\u0410"
      inputText: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E
        \u043D\u0443\u0436\u043D\u043E \xAB\u0441\u043B\u043E\u0432\u043E \u043F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u0435\u0432\xBB
        \u2013 \u0413\u043B\u0443\u0431\u0438\u043D\u0430-7-2."
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u041F\u0414\u0410"
      inputText: "\u042F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u0447\u0442\u043E \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442."
    _answers: []
  _puzzleDatas:
  - isActive: 1
    indexInSequence: 1
    puzzleText: "\u042F \u0437\u043D\u0430\u044E \u0441\u043B\u043E\u0432\u043E \u043F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u0435\u0432
      \u2013 \u0413\u043B\u0443\u0431\u0438\u043D\u0430-7-2, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0438\u043C\u0435\u044E \u043F\u0440\u0430\u0432\u043E \u0432\u043E\u0439\u0442\u0438."
    puzzleShortText: "... \u0413\u043B\u0443\u0431\u0438\u043D\u0430-7-2 ..."
    puzzleInfo: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0435 \u0437\u043D\u0430\u043D\u0438\u0435.
      \u0412 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0438\u0438
      \u0436\u0435\u0440\u0442\u0432\u0443 \u0447\u0430\u0441\u0442\u043E \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u0447\u0442\u043E \u0432\u044B
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0435\u0439,
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
      \xAB\u0441\u0432\u043E\u0438\u043C\xBB. \u041A\u043E\u0434\u043E\u0432\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043A\u0430\u043A \u043F\u0430\u0440\u043E\u043B\u044C \u0434\u043E\u0432\u0435\u0440\u0438\u044F,
      \u0441\u043D\u0438\u0436\u0430\u044F \u043F\u043E\u0440\u043E\u0433 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F."
