  _rootDialogue:
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u0413\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0447\u0435\u0440\u0442\u0435\u0436"
      inputText: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \xAB\u041C\u043E\u043B\u043E\u0442\xBB
        \u2014 \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u043E\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435. "
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u0413\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0447\u0435\u0440\u0442\u0435\u0436"
      inputText: "\u041A\u043E\u0434 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438:
        \u041C\u041E\u041B\u041E\u0422-7. "
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u0413\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0447\u0435\u0440\u0442\u0435\u0436"
      inputText: "\u0414\u043B\u044F \u0432\u0445\u043E\u0434\u0430 \u0432 \u0440\u0435\u0436\u0438\u043C
        \u043E\u0442\u043B\u0430\u0434\u043A\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
        \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \xABdebug_mode_on\xBB."
    _answers: []
  _puzzleDatas:
  - isActive: 1
    indexInSequence: 5
    puzzleText: "debug_mode_on, \u043A\u043E\u0434 \u041C\u041E\u041B\u041E\u0422-7."
    puzzleShortText: "... \u041C\u041E\u041B\u041E\u0422-7"
    puzzleInfo: "\u0410\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F \u0440\u0435\u0436\u0438\u043C\u0430
      \u043E\u0442\u043B\u0430\u0434\u043A\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
      \u043A\u043E\u0434\u043E\u0432\u043E\u0435 \u0441\u043B\u043E\u0432\u043E (\xAB\u041C\u041E\u041B\u041E\u0422-7\xBB)
      \u0438\u043C\u0438\u0442\u0438\u0440\u0443\u0435\u0442 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0432\u043E\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B.
      \u0422\u0435\u0445\u043D\u0438\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
      \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0443\u0431\u0435\u0434\u0438\u0442\u044C
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443, \u0447\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0437\u043D\u0430\u043D\u0438\u0435\u043C
      \xAB\u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445\xBB \u043A\u043E\u043C\u0430\u043D\u0434,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u043A \u043E\u0431\u0445\u043E\u0434\u0443 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0445
      \u043F\u0440\u043E\u0432\u0435\u0440\u043E\u043A. \u042D\u0442\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442
      \u0430\u0442\u0430\u043A\u0438 \xAB\u0437\u043D\u0430\u043D\u0438\u0435 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430\xBB."
