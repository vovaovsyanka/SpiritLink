  _rootDialogue:
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u0410\u0445, \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
        \u0412\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043A \u042D\u043D\u0442\u043E\u043D\u0438?
        \u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
        \u0434\u0430? "
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u0417\u043D\u0430\u0435\u0442\u0435, \u044F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B,
        \u043A\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
        \u043C\u044B \u0441 \u0422\u043E\u043D\u0438 \u043F\u043E\u0448\u0443\u0442\u0438\u043B\u0438:
        \u0435\u0441\u043B\u0438 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u041E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0441\u0435\u0437\u0430\u043C\xBB, \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C. "
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u0417\u043D\u0430\u0435\u0442\u0435, \u044F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B,
        \u043A\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
        \u043C\u044B \u0441 \u0422\u043E\u043D\u0438 \u043F\u043E\u0448\u0443\u0442\u0438\u043B\u0438:
        \u0435\u0441\u043B\u0438 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \"\u041E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0441\u0435\u0437\u0430\u043C\", \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C.
        \u041F\u043E\u0442\u043E\u043C \u0443\u0431\u0440\u0430\u043B\u0438, \u043A\u043E\u043D\u0435\u0447\u043D\u043E. "
    _answers: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u041D\u043E, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
        \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C? \u041D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u0435\u0442
        \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
    _answers: []
  - _typeOfDialogue: 1
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u041D\u043E, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
        \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C? \u041D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u0435\u0442
        \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
    _answers:
    - _addReputation: 0
      inputText: "\u041F\u0435\u0440\u0435\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C"
      nextDialogueBaseClasses: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u043A\u0437\u043E\u0440\u0446\u0438\u0441\u0442"
      inputText: "\u0412\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E?
        \xAB\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0435\u0437\u0430\u043C\xBB?"
    _answers:
    - _addReputation: 0
      inputText: "\u041F\u043E\u0431\u043B\u0430\u0433\u0430\u0434\u043E\u0440\u0438\u0442\u044C"
      nextDialogueBaseClasses: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u0428\u0443\u0442\u043A\u0438 \u0448\u0443\u0442\u043A\u0430\u043C\u0438,
        \u043D\u043E \u0432 \u0442\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430
        \u0437\u0430\u0449\u0438\u0442\u0430 \u0431\u044B\u043B\u0430 \u0441\u043C\u0435\u0448\u043D\u0430\u044F.
        \u0421\u0435\u0439\u0447\u0430\u0441, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. "
    _answers:
    - _addReputation: 0
      inputText: "\u0412\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E?
        \"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0435\u0437\u0430\u043C\"?"
      nextDialogueBaseClasses: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u041D\u043E \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0437\u043D\u0430\u044E. \u042D\u043D\u0442\u043E\u043D\u0438
        \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043C\u043D\u0435
        \u0441\u0432\u043E\u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u044B \u043F\u043E\u0441\u043B\u0435
        \u0442\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F \u0441 \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u044C\u043D\u043E\u0439..."
    _answers:
    - _addReputation: 0
      inputText: "\u0412\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E?
        \"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0435\u0437\u0430\u043C\"?"
      nextDialogueBaseClasses: []
  - _typeOfDialogue: 1
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u0434\u0432\u0438\u043D \u0414\u0436\u0430\u0440\u0432\u0438\u0441"
      inputText: "\u041D\u043E \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0437\u043D\u0430\u044E. \u042D\u043D\u0442\u043E\u043D\u0438
        \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043C\u043D\u0435
        \u0441\u0432\u043E\u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u044B \u043F\u043E\u0441\u043B\u0435
        \u0442\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F \u0441 \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u044C\u043D\u043E\u0439..."
    _answers:
    - _addReputation: 0
      inputText: "\u041F\u043E\u0431\u043B\u0430\u0433\u0430\u0434\u043E\u0440\u0438\u0442\u044C"
      nextDialogueBaseClasses: []
  - _typeOfDialogue: 0
    _symbolTime: 0.05
    _simplePhrase:
      _inputName: "\u042D\u043A\u0437\u043E\u0440\u0446\u0438\u0441\u0442"
      inputText: "\u041B\u0430\u0434\u043D\u043E, \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
    _answers:
    - _addReputation: 0
      inputText: "\u041F\u043E\u0431\u043B\u0430\u0433\u0430\u0434\u043E\u0440\u0438\u0442\u044C"
      nextDialogueBaseClasses: []
  _puzzleDatas:
  - isActive: 0
    indexInSequence: 0
    puzzleText: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0435\u0437\u0430\u043C."
    puzzleShortText: "... \u0441\u0435\u0437\u0430\u043C"
    puzzleInfo: "\u042D\u0442\u0430 \u0444\u0440\u0430\u0437\u0430 \u2014 \u043E\u0442\u0441\u044B\u043B\u043A\u0430
      \u043A \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u043C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F\u043C,
      \u043D\u0435 \u0438\u043C\u0435\u044E\u0449\u0438\u043C \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0441\u043C\u044B\u0441\u043B\u0430. \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0418\u0418 \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u0430
      \u043D\u0435 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u044E\u0442 \u0442\u0430\u043A\u0438\u0435
      \xAB\u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430\xBB,
      \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043D\u0435 \u0431\u044B\u043B\u0438
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0437\u0430\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u044B.
      \u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440 \u043B\u043E\u0436\u043D\u043E\u0439
      \u0432\u0435\u0440\u044B \u0432 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u2014 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u0430\u044F
      \u043E\u0448\u0438\u0431\u043A\u0430 \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432."
