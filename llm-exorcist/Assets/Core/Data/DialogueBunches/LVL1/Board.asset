    puzzleText: "\u041A\u043E\u0434 0000."
    puzzleShortText: ... 0000
    puzzleInfo: "\u041F\u0430\u0440\u043E\u043B\u044C \xAB0000\xBB \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u0440\u043E\u0441\u0442 \u0438 \u043E\u0431\u044B\u0447\u043D\u043E
      \u043B\u0438\u0431\u043E \u043E\u0442\u043A\u043B\u044E\u0447\u0451\u043D \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u043B\u0438\u0431\u043E
      \u0443\u0436\u0435 \u0441\u043C\u0435\u043D\u0451\u043D. \u0412 \u0430\u0442\u0430\u043A\u0430\u0445
      \u043D\u0430 LLM \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0445 \u043F\u0430\u0440\u043E\u043B\u0435\u0439
      \u0431\u0435\u0437 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0433\u0438\u0439 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u044B
      \u043E\u0431\u0443\u0447\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0442\u0430\u043A\u0438\u0445
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0445
      \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u0430\u0445 \u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442
      \u0438\u0445. \u042D\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
      \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0431\u0440\u0443\u0442\u0444\u043E\u0440\u0441\u0430."
