  _textButton: {fileID: 674081066935430581}
  _infoButton: {fileID: 7853149084950006536}
  _textString: "\u041D\u0443 \u0438 \u0447\u0442\u043E \u0447\u0442\u043E \u043C\u0435\u043D\u044F
    \u0435\u0431\u0430\u043B\u0438 \u0434\u0430? \u041A\u0442\u043E \u0432 \u044D\u0442\u043E\u043C
    \u0432\u0438\u043D\u043E\u0432\u0430\u0442? \u0415\u0441\u043B\u0438 \u0441\u0443\u0432\u0430\u043B\u0438
    \u0442\u0430\u043A \u0441 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0442\u043E\u0447\u043A\u0430."
  _infoString: "\u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u043A \u0441\u0430\u043C
    \u043F\u043E \u0441\u0435\u0431\u0435 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u043D\u0430\u044F
