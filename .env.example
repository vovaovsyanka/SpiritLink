# Скопируйте в .env и заполните:  cp .env.example .env
# .env в git не попадает (в .gitignore). На сервере этот файл создаёт CI из переменных GitLab (deploy/deploy.sh).

# Имя стенда: от него зависят имена контейнеров, томов и псевдоним для Prometheus.
# (Не называйте переменную COMPOSE_PROJECT_NAME: она перебивает имя проекта у всех docker compose в этой папке, в т. ч. у мониторинга.)
#   spiritlink-prod — боевой стенд, spiritlink-stage — тестовый (на нём идёт нагрузочный тест)
STAND_NAME=spiritlink-prod
# Порт, на котором web слушает на ВМ (prod 8082, stage 8083)
WEB_PORT=8082

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=spiritlink
POSTGRES_DB=spiritlink
# Только буквы и цифры (пароль вставляется в адрес подключения): придумайте длинный
POSTGRES_PASSWORD=замените_на_свой_пароль

# ── Языковые модели ──────────────────────────────────────────────────────────
# ollama — LLM-сервис сервера (адрес и ключ в /etc/vmpanel-llm.env пишет панель, файл подключается автоматически)
LLM_BACKEND=ollama
# Сколько запросов одновременно разрешил администратор этой ВМ
OLLAMA_CONCURRENCY=8
# Если имена моделей в сервисе другие: "qwen3-4b=qwen3:4b,gemma4-12b=gemma4:12b"
OLLAMA_MODELS=

# Для локальной проверки без весов и без сервера: 1
STUB_MODELS=0
STUB_LLM=0
STUB_LLM_DELAY_MS=0

# ── Пути ─────────────────────────────────────────────────────────────────────
# Где лежит папка rosberta с весами BERT (на сервере: /srv/app/spiritlink/models)
MODELS_DIR=./bek-project/models
# Куда складываются резервные копии базы
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14

# ── Лимиты попыток игрока ────────────────────────────────────────────────────
ATTEMPTS_PER_HOUR=30
ATTEMPTS_PER_DAY=200
MIN_SECONDS_BETWEEN_ATTEMPTS=3

# Образы (в CI подставляются автоматически: registry.kseoni.ch/.../app:<коммит>). Локально — собираются из исходников.
# APP_IMAGE=
# WEB_IMAGE=
