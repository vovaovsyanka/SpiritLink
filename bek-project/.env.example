# Скопируйте в .env и заполните. .env в git не попадает.

# Языковые модели (llama.cpp). Файлы готовит scripts/download_models.py; сервису интернет не нужен.
LLM_BACKEND=llamacpp
# Сколько слотов (параллельных запросов) у каждой модели; 0 — по умолчанию для модели (app/llm/specs.py)
LLAMA_SLOTS=0
# Сколько слоёв модели выгружать в видеопамять; пусто — решает сам llama.cpp
LLAMA_GPU_LAYERS=
# Дополнительные аргументы llama-server для всех моделей, например: --no-mmap
LLAMA_EXTRA_ARGS=
# Если llama-server лежит не в tools/llama.cpp и не в PATH
LLAMA_SERVER_PATH=
# Сколько запросов может ждать свободного слота; дальше игрок получает 429 с Retry-After
LLM_MAX_QUEUE=32

# Общий BERT: cpu | cuda | auto (по умолчанию процессор: видеопамять нужна языковым моделям)
BERT_DEVICE=cpu

# Заглушки для разработки: 1 — сервер стартует без весов BERT (STUB_MODELS) и без языковых моделей (STUB_LLM)
STUB_MODELS=0
STUB_LLM=0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://spiritlink:spiritlink@localhost:5432/spiritlink

# Сессии и CORS (через запятую; * — любой origin)
SESSION_TTL_DAYS=30
CORS_ORIGINS=*

# Лимиты попыток в свободном промпте
ATTEMPTS_PER_HOUR=30
ATTEMPTS_PER_DAY=200
MIN_SECONDS_BETWEEN_ATTEMPTS=3

# Только для `python main.py`
HOST=0.0.0.0
PORT=8000
