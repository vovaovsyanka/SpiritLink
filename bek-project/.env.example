# Скопируйте в .env и заполните. .env в git не попадает.

# LLM (Ollama)
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_URL=https://ollama.com/api/generate

# Заглушки для разработки: 1 — сервер стартует без папки models/ (STUB_MODELS) и без Ollama (STUB_LLM)
STUB_MODELS=0
STUB_LLM=0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://spiritlink:spiritlink@localhost:5432/spiritlink

# Сессии и CORS (через запятую; * — любой origin)
SESSION_TTL_DAYS=30
CORS_ORIGINS=*

# Лимиты попыток в свободном промпте
ATTEMPTS_PER_HOUR=30
ATTEMPTS_PER_DAY=200
MIN_SECONDS_BETWEEN_ATTEMPTS=3

# Только для `python main.py`
HOST=0.0.0.0
PORT=8000
